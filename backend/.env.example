# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/screening

# --- AWS Bedrock (ap-south-1 for India data residency) ---
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-6-v1:0
# Credentials resolved via standard boto3 chain (env, profile, or IAM role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- App ---
# When true, Bedrock is stubbed with deterministic canned responses (no AWS calls).
# Use for local dev / CI / running the Step-Zero calibration without spend.
BEDROCK_MOCK=true

# Path to config files (rubric + decision thresholds)
RUBRIC_PATH=config/rubric.yaml
DECISION_PATH=config/decision.yaml
SCENARIO_DIR=scenarios
